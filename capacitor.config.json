{
  "appId": "com.dacquery.doubleflap",
  "appName": "Double Flap",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#1a1a2e",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#1a1a2e",
      "overlaysWebView": true
    },
    "ScreenOrientation": {
      "orientation": "landscape"
    }
  }
}
